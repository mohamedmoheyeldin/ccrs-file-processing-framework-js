{
  "name": "ccrs-file-processing-framework",
  "version": "1.5.4",
  "description": "Pure JavaScript Electron desktop app for the CCRS File Processing Framework.",
  "main": "electron/main.js",
  "author": "Mohamed Moheyeldin (Eldin)",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/generate-user-guide-pdf.js && node scripts/sync-build-version.js && node scripts/build-renderer.js",
    "start": "electron .",
    "pretest": "node scripts/generate-user-guide-pdf.js && node scripts/sync-build-version.js && node scripts/build-renderer.js",
    "test": "pnpm run test:instructions && pnpm run test:migrate && pnpm run test:syntax && pnpm run test:smoke && pnpm run test:regression && pnpm run test:upload",
    "test:upload": "node scripts/upload-sftp-test.js",
    "verify": "pnpm test",
    "test:instructions": "node scripts/sync-agent-instructions.js --check",
    "sync:instructions": "node scripts/sync-agent-instructions.js",
    "test:migrate": "node scripts/migrate-repo-test.js",
    "migrate:repo": "node scripts/migrate-repo.js",
    "test:syntax": "node scripts/syntax-check.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:e2e": "node scripts/build-renderer.js && node scripts/electron-e2e-test.js",
    "build:renderer": "node scripts/build-renderer.js",
    "data:stations": "node scripts/import-stations.js",
    "data:seoc": "node scripts/import-seoc.js",
    "predist": "node scripts/generate-user-guide-pdf.js && node scripts/sync-build-version.js && node scripts/build-renderer.js",
    "dist": "node scripts/build-release.js",
    "test:regression": "node scripts/workflow-regression-test.js"
  },
  "dependencies": {
    "ssh2-sftp-client": "^12.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "@untitledui/icons": "^0.0.23",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0"
  },
  "build": {
    "appId": "com.ccrs.fileprocessingframework",
    "productName": "CCRS File Processing Framework",
    "files": [
      "electron/**/*",
      "!electron/renderer/src/**/*",
      "assets/icons/ccrs_app_icon.ico",
      "assets/icons/ccrs_app_icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "electron/backend/**/*"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*",
          "!images/**"
        ]
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "upload_import",
        "to": "upload_import"
      }
    ],
    "extraFiles": [
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*",
          "!images/**"
        ]
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "upload_import",
        "to": "upload_import"
      }
    ],
    "win": {
      "icon": "assets/icons/ccrs_app_icon.ico",
      "defaultArch": "x64",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "uninstallDisplayName": "CCRS File Processing Framework Version 1.5.4",
      "installerIcon": "assets/icons/ccrs_app_icon.ico",
      "uninstallerIcon": "assets/icons/ccrs_app_icon.ico",
      "installerHeaderIcon": "assets/icons/ccrs_app_icon.ico",
      "include": "scripts/installer.nsh"
    }
  },
  "packageManager": "pnpm@11.22.0"
}
