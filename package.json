{
  "name": "ccrs-file-processing-framework",
  "version": "1.2.0",
  "description": "Pure JavaScript Electron desktop app for the CCRS File Processing Framework.",
  "main": "electron/main.js",
  "author": "Mohamed Moheyeldin (Eldin)",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/generate-user-guide-pdf.js && node scripts/sync-build-version.js",
    "start": "electron .",
    "pretest": "node scripts/generate-user-guide-pdf.js && node scripts/sync-build-version.js",
    "test": "node scripts/smoke-test.js",
    "predist": "node scripts/generate-user-guide-pdf.js && node scripts/sync-build-version.js",
    "dist": "electron-builder --win --x64",
    "postdist": "node scripts/export-release-artifacts.js --mode=full",
    "predist:portable": "node scripts/generate-user-guide-pdf.js && node scripts/sync-build-version.js",
    "dist:portable": "electron-builder --win portable --x64",
    "postdist:portable": "node scripts/export-release-artifacts.js --mode=portable"
  },
  "dependencies": {
    "ssh2-sftp-client": "^12.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ccrs.fileprocessingframework",
    "productName": "CCRS File Processing Framework",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "upload_import",
        "to": "upload_import"
      }
    ],
    "extraFiles": [
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "upload_import",
        "to": "upload_import"
      }
    ],
    "win": {
      "icon": "assets/icons/ccrs_app_icon.ico",
      "defaultArch": "x64",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "uninstallDisplayName": "CCRS File Processing Framework Production V1.2",
      "installerIcon": "assets/icons/ccrs_app_icon.ico",
      "uninstallerIcon": "assets/icons/ccrs_app_icon.ico",
      "installerHeaderIcon": "assets/icons/ccrs_app_icon.ico"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
