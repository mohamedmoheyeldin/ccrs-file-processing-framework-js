{
  "name": "ccrs-file-processing-framework",
  "version": "1.0.0",
  "description": "Pure JavaScript Electron desktop app for the CCRS File Processing Framework.",
  "main": "electron/main.js",
  "author": "Mohamed Moheyeldin (Eldin)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "ssh2-sftp-client": "^12.0.1"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ccrs.fileprocessingframework",
    "productName": "CCRS File Processing Framework",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "upload_import",
        "to": "upload_import"
      }
    ],
    "win": {
      "icon": "assets/icons/ccrs_app_icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "assets/icons/ccrs_app_icon.ico",
      "uninstallerIcon": "assets/icons/ccrs_app_icon.ico",
      "installerHeaderIcon": "assets/icons/ccrs_app_icon.ico"
    }
  }
}
