{
  "name": "ccrs-file-processing-framework",
  "version": "1.2.4",
  "description": "Pure JavaScript Electron desktop app for the CCRS File Processing Framework.",
  "main": "electron/main.js",
  "author": "Mohamed Moheyeldin (Eldin)",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/generate-user-guide-pdf.js && node scripts/sync-build-version.js",
    "start": "electron .",
    "pretest": "node scripts/generate-user-guide-pdf.js && node scripts/sync-build-version.js",
    "test": "npm run test:smoke",
    "test:smoke": "node scripts/smoke-test.js",
    "predist": "node scripts/generate-user-guide-pdf.js && node scripts/sync-build-version.js",
    "dist": "node scripts/build-release.js"
  },
  "dependencies": {
    "ssh2-sftp-client": "^12.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ccrs.fileprocessingframework",
    "productName": "CCRS File Processing Framework",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "upload_import",
        "to": "upload_import"
      }
    ],
    "extraFiles": [
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "upload_import",
        "to": "upload_import"
      }
    ],
    "win": {
      "icon": "assets/icons/ccrs_app_icon.ico",
      "defaultArch": "x64",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "uninstallDisplayName": "CCRS File Processing Framework Version 1.2",
      "installerIcon": "assets/icons/ccrs_app_icon.ico",
      "uninstallerIcon": "assets/icons/ccrs_app_icon.ico",
      "installerHeaderIcon": "assets/icons/ccrs_app_icon.ico"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
